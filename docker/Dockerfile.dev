FROM node:22-bookworm-slim

WORKDIR /app

RUN sed -i "s|http://deb.debian.org/debian|http://mirrors.ustc.edu.cn/debian|g; s|http://deb.debian.org/debian-security|http://mirrors.ustc.edu.cn/debian-security|g" /etc/apt/sources.list.d/debian.sources \
  && apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 update \
  && apt-get install -y --no-install-recommends python3 make g++ git ca-certificates curl chromium fonts-liberation fonts-noto-cjk xvfb x11vnc novnc websockify \
  && rm -rf /var/lib/apt/lists/*

ENV PYTHON=/usr/bin/python3

ENV SITE_AUTH_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
ENV SITE_AUTH_NOVNC_PORT=6080
ENV SITE_AUTH_VNC_PORT=5900
