# Fork-local runtime template. Copy to .env and replace every secret before deploying.
AUTH_TOKEN=change-me
PROXY_TOKEN=sk-change-me
ACCOUNT_CREDENTIAL_SECRET=change-me
PORT=4000
FRONTEND_PORT=4000
BACKEND_PORT=4001
BACKEND_DEBUG_PORT=4001
TZ=Asia/Shanghai
CHECKIN_CRON=0 8 * * *
BALANCE_REFRESH_CRON=0 * * * *
CHOKIDAR_USEPOLLING=true

# Third-party login credential controlled browser.
# Opens a Metapi popup for LinuxDO / GitHub / Google login and stores the browser credential.
SITE_AUTH_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
SITE_AUTH_BROWSER_PROXY_URL=
SITE_AUTH_BROWSER_HEADLESS=false
SITE_AUTH_BROWSER_DISPLAY=:99
