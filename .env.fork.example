# Fork-local runtime template. Copy to .env and replace every secret before deploying.
AUTH_TOKEN=change-me-admin-token
PROXY_TOKEN=sk-change-me-proxy-token
ACCOUNT_CREDENTIAL_SECRET=replace-with-32-plus-byte-random-secret
PORT=4000
FRONTEND_PORT=4000
BACKEND_PORT=4001
BACKEND_DEBUG_PORT=4001
TZ=Asia/Shanghai
CHECKIN_CRON=0 8 * * *
BALANCE_REFRESH_CRON=0 * * * *
CHOKIDAR_USEPOLLING=true
