# Fork-local runtime template. Copy to .env and replace every secret before deploying.
AUTH_TOKEN=change-me
PROXY_TOKEN=sk-change-me
ACCOUNT_CREDENTIAL_SECRET=change-me
PORT=4000
FRONTEND_PORT=4000
BACKEND_PORT=4001
BACKEND_DEBUG_PORT=4001
TZ=Asia/Shanghai
CHECKIN_CRON=0 8 * * *
BALANCE_REFRESH_CRON=0 * * * *
CHOKIDAR_USEPOLLING=true

# Third-party login credential popup authorization.
# Required only when using OAuth 管理 -> 新建 OAuth 连接 -> 站点登录授权 for GitHub / Google.
# Register callback URLs on the OAuth app side, for example:
#   http://your-host:4000/api/site-auth/callback/github
#   http://your-host:4000/api/site-auth/callback/google
SITE_AUTH_GITHUB_CLIENT_ID=
SITE_AUTH_GITHUB_CLIENT_SECRET=
SITE_AUTH_GOOGLE_CLIENT_ID=
SITE_AUTH_GOOGLE_CLIENT_SECRET=
